# Copie para .env e preencha. O .env NUNCA deve ser commitado.

# Banco MySQL local
DB_USER=root
DB_PASSWORD=root

# Segredo do JWT (use uma string longa e aleatoria)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# SMTP para recuperacao de senha (opcional em dev)
MAIL_HOST=smtp.seuprovedor.com
MAIL_USERNAME=
MAIL_PASSWORD=
